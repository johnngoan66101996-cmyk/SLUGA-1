# ==============================================================================
# КОНФИГУРАЦИЯ СЕРВЕРНОГО АГЕНТА SLUGA
# Скопируйте этот файл в .env перед запуском: cp .env.example .env
# ==============================================================================

# 1. Токен безопасности и связи с ботом (генерируется автоматически при setup.sh)
# Используется клиентом (SlugaGram или моб. приложением) для авторизации
SLUGA_BOT_TOKEN=sluga-your-bot-token-here

# 2. Ключ доступа к официальному шлюзу LiteAI (https://liteai.tech/docs)
# Получите единый API-ключ вида sk-bf-... в личном кабинете LiteAI
LITEAI_API_KEY=sk-bf-your-api-key-here

# 3. Активная ИИ-модель из каталога LiteAI
# Доступные проверенные модели:
#   claude-sonnet-4.6                (Рекомендуется по умолчанию: код, архитектура, баланс)
#   claude-opus-4.8                  (Тяжелая логика, максимум рассуждений)
#   claude-haiku-4.5                 (Экономная, сверхбыстрая)
#   gpt-5.6-sol                      (OpenAI флагман, универсальная)
#   gpt-5.6-luna                     (OpenAI флагман глубоких рассуждений)
#   openai/gpt-4o                    (Мультимодальная)
#   deepseek/deepseek-chat           (Ультра-экономная: расход в 20 раз ниже Sonnet!)
#   qwen/qwen-2.5-coder-32b-instruct (Специализированная модель для чистого кода)
#   glm-5.3-flash                    (Мгновенная, ультра-дешевая)
LITEAI_MODEL=claude-sonnet-4-6

# 4. Официальный базовый URL шлюза LiteAI (без VPN)
LITEAI_BASE_URL=https://api.liteai.tech/v1

# 5. ВАШ ДОМЕН — ГЛАВНЫЙ ПАРАМЕТР (без http/https, без слеша)
# Именно через этот домен SlugaGram и все клиенты подключаются к агенту.
# Сервер внутри слушает 127.0.0.1:8080 (это скрыто от клиента).
# Пример: SLUGA_DOMAIN=sugatov-it.ru
SLUGA_DOMAIN=sugatov-it.ru

# 6. Внутренний порт uvicorn (НЕ меняйте без крайней необходимости!)
# Должен совпадать с портом в .htaccess RewriteRule.
# Клиент НИКОГДА не обращается на этот порт напрямую — только через домен.
SERVER_PORT=8080

# 7. Голосовой синтез Microsoft Edge-TTS (бесплатно, без API ключей)
# Варианты: ru-RU-DmitryNeural (мужской), ru-RU-SvetlanaNeural (женский)
TTS_VOICE=ru-RU-DmitryNeural

# 8. Лимит автономных итераций ReAct (безопасность от бесконечных циклов)
MAX_REACT_STEPS=8
